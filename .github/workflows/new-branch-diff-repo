name: Cross-Repo Branch Creator

on:
  workflow_dispatch:
    inputs:
      confirm_create:
        description: 'Centang untuk mengaktifkan pembuatan branch (Boolean)'
        required: true
        type: boolean
        default: true
      branch_name:
        description: 'Ketik nama branch baru di sini (Empty Field)'
        required: false
        type: string

# Izin agar GitHub Actions bisa push ke repo ini
permissions:
  contents: write

jobs:
  create-branch:
    runs-on: ubuntu-latest
    steps:
      - name: Validasi Input
        if: inputs.confirm_create == true && inputs.branch_name != ''
        run: |
          if [[ "${{ inputs.branch_name }}" == *" "* ]]; then
            echo "❌ Error: Nama branch tidak boleh mengandung spasi!"
            exit 1
          fi
          echo "✅ Input valid. Siap mengambil dari source dan push ke target."

      - name: Checkout Source Repository
        if: inputs.confirm_create == true && inputs.branch_name != ''
        uses: actions/checkout@v4
        with:
          repository: arazy79/android_kernel_asus_sdm660-4.19_rsuntk
          ref: master
          path: temp-source
          fetch-depth: 0
          # CATATAN: Jika repo source ini PRIVATE, hapus tanda pagar di baris bawah 
          # dan buat PAT di settings GitHub kamu, lalu masukkan ke Secrets dengan nama PAT_TOKEN
          # token: ${{ secrets.PAT_TOKEN }}

      - name: Konfigurasi Git & Push ke Target
        if: inputs.confirm_create == true && inputs.branch_name != ''
        run: |
          cd temp-source
          
          # Konfigurasi user git
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          
          # Tambahkan remote target repo menggunakan token bawaan GitHub Actions
          # github.repository otomatis mendeteksi repo tempat workflow ini disimpan (android-kernel-tes-4.19)
          git remote add target https://x-access-token:${{ secrets.GITHUB_TOKEN }}@github.com/${{ github.repository }}.git
          
          # Buat branch baru berdasarkan master dari source
          git checkout -b "${{ inputs.branch_name }}"
          
          # Push branch baru tersebut ke repo target
          git push target "${{ inputs.branch_name }}"
          
          echo "✅ Sukses! Branch '${{ inputs.branch_name }}' (berdasarkan master source) telah dibuat di repo target."

      - name: Info Pembatalan
        if: inputs.confirm_create == false || inputs.branch_name == ''
        run: |
          echo "⚠️ Pembuatan branch dilewati."
          echo "Pastikan kamu mencentang konfirmasi dan mengisi nama branch."
